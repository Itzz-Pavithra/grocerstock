# Frontend Public Environment Variables (Vite/SvelteKit)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_MAPTILER_API_KEY=YOUR_MAPTILER_API_KEY

# Backend Environment Variables (For local server or Vercel Environment Variables)
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=grocery-stock-request-system
JWT_SECRET=your_super_secret_jwt_key_here
OTP_EXPIRY_MINUTES=10
FRONTEND_URL=http://localhost:5173

# Email Service (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="GrocerStock <no-reply@grocerstock.com>"



