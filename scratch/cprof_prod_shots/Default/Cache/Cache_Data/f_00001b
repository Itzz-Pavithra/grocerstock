			$.set(loginError, 'Email is required');
			$.set(loginLoading, false);

			return;
		}

		if (!$.get(loginPassword)) {
			document.getElementById('login-password')?.focus();
			$.set(loginError, 'Password is required');
			$.set(loginLoading, false);

			return;
		}

		try {
			const res = (await $.track_reactivity_loss(api.post('/auth/login', { email: $.get(loginEmail), password: $.get(loginPassword) })))();

			if (res.requireOtp) {
				$.set(otpEmail, res.email, true);
				$.set(view, 'otp');
				startResendTimer();
				toasts.warning('Please enter the 6-digit verification code sent to your email.');

				return;
			}

			auth.setSession(res, res.token);

			let targetPath = '/';

			if ($.strict_equals(res.role, 'retailer')) targetPath = '/retailer'; else if ($.strict_equals(res.role, 'wholesaler')) targetPath = '/wholesaler'; else if ($.strict_equals(res.role, 'admin')) targetPath = '/admin';

			(await $.track_reactivity_loss(goto(targetPath)))();

