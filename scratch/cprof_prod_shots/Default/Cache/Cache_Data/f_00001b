			$.set(regError, 'Phone number is required');
			$.set(regLoading, false);

			return;
		}

		if (!$.get(address)) {
			document.getElementById('address')?.focus();
			$.set(regError, 'Address is required');
			$.set(regLoading, false);

			return;
		}

		try {
