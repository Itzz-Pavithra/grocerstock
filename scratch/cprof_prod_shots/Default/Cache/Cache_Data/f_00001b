			$.set(regError, 'Passwords do not match');
			$.set(regLoading, false);

			return;
		}

		if ($.strict_equals($.get(regRole), 'retailer') && !$.get(storeName)) {
			document.getElementById('store-name')?.focus();
			$.set(regError, 'Store name is required');
			$.set(regLoading, false);

