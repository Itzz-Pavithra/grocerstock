	async function handleCreateDispute(e) {
		e.preventDefault();

		if (!$.get(selectedOrderForDispute)) return;

		if (!$.get(disputeReasonInput).trim() || !$.get(disputeDescriptionInput).trim()) {
			toasts.error('Please specify dispute reason and details');

			return;
		}

		$.set(disputeFormLoading, true);

		try {
			const res = (await $.track_reactivity_loss(api.post(`/admin/orders/${$.get(selectedOrderForDispute)._id}/dispute`, {
				reason: $.get(disputeReasonInput).trim(),
				description: $.get(disputeDescriptionInput).trim()
			})))();

			toasts.success(`Dispute ${res.dispute.disputeId} logged successfully`);
			$.set(showCreateDisputeModal, false);
			(await $.track_reactivity_loss(loadOrders()))();
			(await $.track_reactivity_loss(loadDisputes()))();
			loadOverview();
		} catch(err) {
			toasts.error(err.message || 'Failed to create dispute');
		} finally {
			$.set(disputeFormLoading, false);
		}
	}

	function openResolveDispute(disp) {
		$.set(selectedDisputeForResolve, disp, true);
		$.set(disputeResolveStatus, $.strict_equals(disp.status, 'open') ? 'under_investigation' : 'resolved', true);
		$.set(disputeInvestigationNotes, disp.investigationNotes || '', true);
		$.set(disputeResolutionOutcome, disp.resolutionOutcome || '', true);
		$.set(showResolveDisputeModal, true);
	}

	async function handleResolveDispute(e) {
		e.preventDefault();

		if (!$.get(selectedDisputeForResolve)) return;

		$.set(disputeResolveLoading, true);

		try {
			(await $.track_reactivity_loss(api.put(`/admin/disputes/${$.get(selectedDisputeForResolve)._id}/resolve`, {
				status: $.get(disputeResolveStatus),
				investigationNotes: $.get(disputeInvestigationNotes).trim(),
				resolutionOutcome: $.get(disputeResolutionOutcome).trim()
			})))();

			toasts.success(`Dispute marked as ${$.get(disputeResolveStatus).toUpperCase().replace(/_/g, ' ')}`);
			$.set(showResolveDisputeModal, false);
			(await $.track_reactivity_loss(loadDisputes()))();
			(await $.track_reactivity_loss(loadOrders()))();
			loadOverview();
		} catch(err) {
			toasts.error(err.message || 'Failed to update dispute');
		} finally {
			$.set(disputeResolveLoading, false);
		}
	}

