  --color-border: #32353B;

  --color-charcoal: #202124;
  --color-pale-blue: #B9DDE5;
  --color-mustard: #D4A72C;
}

/* Custom Scrollbars */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background-color: var(--color-border);
  border-radius: 9999px;
}

/* 3D & Perspective Utilities */
.perspective-container {
  perspective: 1200px;
}
.preserve-3d {
  transform-style: preserve-3d;
}

/* Glow Effects */
.glow-mustard {
  box-shadow: 0 10px 30px -10px rgba(212, 167, 44, 0.45);
}
.glow-mustard-lg {
  box-shadow: 0 20px 45px -12px rgba(212, 167, 44, 0.55);
}
.glow-paleblue {
  box-shadow: 0 10px 30px -10px rgba(185, 221, 229, 0.4);
}
.glow-charcoal {
  box-shadow: 0 20px 50px -15px rgba(32, 33, 36, 0.35);
}

/* Animations */
@keyframes toast-slide-in {
  0% { transform: translateY(1.5rem) scale(0.95); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}
.animate-toast {
  animation: toast-slide-in 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes float-gentle {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-8px) rotate(1deg); }
}
.animate-float {
  animation: float-gentle 5s ease-in-out infinite;
}

@keyframes float-slow {
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-12px) rotate(-1.5deg); }
}
.animate-slow-float {
  animation: float-slow 7s ease-in-out infinite;
}

/* 3D Dashboard Floating Animations */
@keyframes float-3d-main {
  0%, 100% {
    transform: rotateX(7deg) rotateY(-9deg) translateY(0px);
  }
  50% {
    transform: rotateX(3deg) rotateY(-4deg) translateY(-16px);
  }
}
.animate-float-3d {
  animation: float-3d-main 8s ease-in-out infinite;
}

@keyframes float-chip-up {
  0%, 100% {
    transform: translateZ(40px) translateY(0px);
  }
  50% {
    transform: translateZ(60px) translateY(-14px);
  }
}
.animate-float-chip-1 {
  animation: float-chip-up 6s ease-in-out infinite;
}

@keyframes float-chip-down {
  0%, 100% {
    transform: translateZ(35px) translateY(0px);
  }
  50% {
    transform: translateZ(55px) translateY(12px);
  }
}
.animate-float-chip-2 {
  animation: float-chip-down 7s ease-in-out 0.8s infinite;
}

@keyframes float-chip-side {
  0%, 100% {
    transform: translateZ(45px) translateX(0px) translateY(0px);
  }
  50% {
    transform: translateZ(65px) translateX(-6px) translateY(-10px);
  }
}
.animate-float-chip-3 {
  animation: float-chip-side 6.5s ease-in-out 1.5s infinite;
}

/* Ambient Moving Gradient Orbs */
@keyframes orb-move-1 {
  0%, 100% {
    transform: translate(0px, 0px) scale(1);
  }
  33% {
    transform: translate(40px, -30px) scale(1.12);
  }
  66% {
    transform: translate(-30px, 20px) scale(0.92);
  }
}
.animate-orb-1 {
  animation: orb-move-1 14s ease-in-out infinite;
}

@keyframes orb-move-2 {
  0%, 100% {
    transform: translate(0px, 0px) scale(1);
  }
  33% {
    transform: translate(-35px, 25px) scale(0.95);
  }
  66% {
    transform: translate(25px, -35px) scale(1.1);
  }
}
.animate-orb-2 {
  animation: orb-move-2 16s ease-in-out infinite;
}

@keyframes wave-pulse {
  0%, 100% { opacity: 0.6; transform: scale(1); }
  50% { opacity: 1; transform: scale(1.03); }
}
.animate-wave {
  animation: wave-pulse 4s ease-in-out infinite;
}

@keyframes page-fade-in {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
.animate-page-fade {
  animation: page-fade-in 0.3s ease-out forwards;
}

/* Shimmer Loading */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.animate-shimmer {
  background: linear-gradient(90deg, var(--color-surface) 25%, var(--color-surface-subtle) 50%, var(--color-surface) 75%);
