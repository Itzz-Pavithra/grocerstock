				? 'உள்நுழைவு வெற்றியடைந்தது!'
				: 'Signed in successfully!');
		} catch(err) {
			if (err.message.includes('not verified') || err.message.includes('OTP')) {
				$.set(otpEmail, $.get(loginEmail), true);
				$.set(view, 'otp');
				startResendTimer();
				toasts.warning('Email verification required. Code sent to your inbox.');
			} else {
				$.set(loginError, err.message || 'Login failed', true);
				toasts.error($.get(loginError));
			}
		} finally {
			$.set(loginLoading, false);
		}
	}

	async function handleRegister(e) {
