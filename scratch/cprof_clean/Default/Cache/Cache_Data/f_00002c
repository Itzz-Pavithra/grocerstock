  --color-bg: #F7F5EF;
  --color-surface: #FFFFFF;
  --color-surface-subtle: #EFECE2;
  --color-surface-secondary: #B9DDE5;
  
  --color-text: #202124;
  --color-text-muted: #5F6368;
  --color-border: #E2DDD0;

  --color-charcoal: #202124;
  --color-pale-blue: #B9DDE5;
  --color-mustard: #D4A72C;
}

.dark {
  --color-primary: #D4A72C;
  --color-primary-hover: #E4BA3D;
  --color-primary-light: #332B18;
  
